# Copier ce fichier vers .env seulement lorsque l'accès neuPrint sera nécessaire.
# Ne jamais versionner ni communiquer le jeton dans un message.
NEUPRINT_SERVER=https://neuprint.janelia.org
NEUPRINT_DATASET=male-cns:v1.0
NEUPRINT_APPLICATION_CREDENTIALS=

# Dryad exige désormais un jeton Bearer pour télécharger les octets des fichiers,
# même publics. Le script retire ce secret avant la redirection vers le stockage.
DRYAD_BEARER_TOKEN=
