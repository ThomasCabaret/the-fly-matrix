# Copier ce fichier vers .env seulement lorsqu'un accès distant sera nécessaire.
# Voir docs/reproduction-pipeline.md pour l'usage, la création et la durée de vie.
# Ne jamais versionner ni communiquer un jeton ou un secret dans un message.
NEUPRINT_SERVER=https://neuprint.janelia.org
NEUPRINT_DATASET=male-cns:v1.0
NEUPRINT_APPLICATION_CREDENTIALS=

# Dryad exige désormais un jeton Bearer de courte durée pour télécharger les
# octets, même publics. Le script retire ce jeton avant la redirection vers le
# stockage. Ne pas mettre l'ID d'application ou le secret Dryad dans ce fichier.
DRYAD_BEARER_TOKEN=
